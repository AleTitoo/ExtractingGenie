{
  "name": "genie-report-studio",
  "version": "1.0.4",
  "description": "Local, traceable extraction of weighted activities from GENIE reports",
  "main": "desktop/main.js",
  "author": "Alexandre Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleTitoo/ExtractingGenie.git"
  },
  "scripts": {
    "dist": "powershell -NoProfile -File scripts/build.ps1"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aletitoo.geniereportstudio",
    "productName": "GENIE Report Studio",
    "executableName": "GENIE-Report-Studio",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "desktop/main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/GENIE-Report-Studio.exe",
        "to": "backend/GENIE-Report-Studio.exe"
      },
      {
        "from": "assets/genie-report-studio.ico",
        "to": "genie-report-studio.ico"
      }
    ],
    "win": {
      "icon": "assets/genie-report-studio.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "GENIE-Report-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GENIE Report Studio"
    }
  }
}
