{
  "name": "platinum-189",
  "version": "1.0.9",
  "description": "Local, traceable extraction of weighted activities from GENIE reports",
  "main": "desktop/main.js",
  "author": "Alexandre Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleTitoo/ExtractingGenie.git"
  },
  "scripts": {
    "dist": "powershell -NoProfile -File scripts/build.ps1"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aletitoo.platinum189",
    "productName": "Platinum-189",
    "executableName": "Platinum-189",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "desktop/main.js",
      "desktop/migration.js",
      "package.json",
      "desktop/updater.js"
    ],
    "extraResources": [
      {
        "from": "desktop/install-update.ps1",
        "to": "install-update.ps1"
      },
      {
        "from": "backend-dist/Platinum-189.exe",
        "to": "backend/Platinum-189.exe"
      },
      {
        "from": "assets/platinum-189.ico",
        "to": "platinum-189-v2.ico"
      }
    ],
    "win": {
      "icon": "assets/platinum-189.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Platinum-189-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Platinum-189"
    }
  }
}
